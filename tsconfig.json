{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src", "scripts"]
}
